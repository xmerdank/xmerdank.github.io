#!name=xYoutube(Music)
#!desc=Youtube Ad Full blocker with PIP player
#!author = xmerdank [https://github.com/xmerdank]
#!icon = https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/YouTube.png
#!date = 2025-05-13 15:17:08
#!system=iOS, iPadOS, macOS
#!system_version=15
#!loon_version=3.2.4(787)
# > Credit
# @Maasea @Choler & @DivineEngine & @app2smile

[Argument]
blockUpload=switch, false, true, tag=Скрыть кнопку загрузки, desc=Используется для скрытия кнопки загрузки на нижней панели YouTube
blockShorts=switch, false, true, tag=Скрыть кнопку Shorts, desc=Используется для скрытия кнопки Shorts на нижней панели YouTube
blockImmersive=switch, false, true, tag=Скрыть кнопку выбора, desc=Используется для скрытия кнопки выбора на нижней панели YouTube Music
captionLang=select, "ru", "en", "off", tag=Язык перевода субтитров, desc=На какой язык вы хотите перевести субтитры YouTube?
lyricLang=select, "ru", "en", "off", tag=Язык перевода текста, desc=На какой язык вы хотите перевести субтитры YouTube Music?
debug=switch, false, true, tag=Включить режим отладки, desc=Режим отладки для этого плагин

[Rule]
AND, ((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, youtubei.googleapis.com), (PROTOCOL, QUIC)), REJECT

[Rewrite]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad reject-200

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch) script-path=https://github.com/Moli-X/Tool/raw/X/Loon/Plugin/Kelee/Script/YouTube_remove_ads_response.js, requires-body = true, binary-body-mode = true, argument=[{blockUpload},{blockShorts},{blockImmersive},{captionLang},{lyricLang},{debug}],tag=YouTube request 

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com