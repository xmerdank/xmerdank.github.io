#!name=xYoutube(Music)
#!desc=Убирает рекламу в YouTube и YouTube Music, включает PiP, фоновое воспроизведение и перевод субтитров. Скрипты загружаются напрямую у автора (Maasea). В настройках Loon включите MitM over HTTP/2.
#!author=xmerdank[https://github.com/xmerdank], Maasea[https://github.com/Maasea]
#!homepage=https://github.com/Maasea/sgmodule
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-11-06 00:00:00
#!system=iOS, iPadOS, macOS
#!system_version=15

[Argument]
blockUpload=switch, false, true, tag=Скрыть кнопку загрузки, desc=Скрывает кнопку загрузки на нижней панели YouTube
blockShorts=switch, false, true, tag=Скрыть кнопку Shorts, desc=Скрывает кнопку Shorts на нижней панели YouTube
blockImmersive=switch, false, true, tag=Скрыть кнопку выбора, desc=Скрывает кнопку выбора на нижней панели YouTube Music
captionLang=select, "ru", "en", "tk", "off", tag=Язык перевода субтитров, desc=На какой язык переводить субтитры YouTube (off — не переводить)
debug=switch, false, true, tag=Режим отладки, desc=Подробные логи скрипта

[Rule]
# QUIC обходит HTTPS-расшифровку, поэтому для YouTube он запрещается — приложение переходит на TCP
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$/i then script("https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="YouTube — реклама", requires_body=true, binary_body_mode=true
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js", {${captionLang}}) with tag="YouTube — инициализация", requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="YouTube — события", requires_body=true, binary_body_mode=true

[MitM]
hostname=*.googlevideo.com, youtubei.googleapis.com
